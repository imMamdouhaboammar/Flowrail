{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flowrail session transition result",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "example": {
          "type": "boolean"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "ACTIVE",
            "VERIFYING",
            "COMPLETED",
            "ABORTED"
          ]
        },
        "outcome": {
          "const": "OK"
        },
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "verification_snapshot": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^blake3:[0-9a-f]{64}$"
            },
            {
              "const": "example-only"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "example",
        "session_id",
        "revision",
        "phase",
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "example": {
          "type": "boolean"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "ACTIVE",
            "BLOCKED",
            "VERIFYING",
            "COMPLETED",
            "ABORTED",
            "RECOVERY_REQUIRED"
          ]
        },
        "outcome": {
          "const": "ERROR"
        },
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "suggested_action": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "path",
                  "line"
                ],
                "additionalProperties": false
              }
            },
            "proposal_id": {
              "type": "string",
              "minLength": 1
            },
            "impact_revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "suggested_action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "example",
        "session_id",
        "revision",
        "phase",
        "outcome",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "OK"
          },
          "phase": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "required": [
          "verification_snapshot"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "example": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "verification_snapshot": {
            "type": "string",
            "pattern": "^blake3:[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
